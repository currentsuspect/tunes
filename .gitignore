# node
# No trailing slash: a node_modules SYMLINK is a file, and "node_modules/" let
# two of them be committed (tunesd/, edge/), which took the box daemon down.
node_modules
dist/
*.log

# tunesd runtime state — never commit sessions, media, or local config
tunesd/data/
tunesd/data-e2e/
tunesd/config.local*
tunesd/.env

# flutter (app/ has its own .gitignore from flutter create; keep root lean)
app/build/
app/.dart_tool/

# deploy artifacts
tools/dist/
# wrangler local state (local D1 sqlite, dev cache)
.wrangler/
