<?xml version="1.0" encoding="utf-8"?>
<!-- The song's progress: a coral line on a sand track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#FFE7DFCC"/><corners android:radius="3dp"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#FFFF5A4E"/><corners android:radius="3dp"/></shape></clip>
    </item>
</layer-list>
